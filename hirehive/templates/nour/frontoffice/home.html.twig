{% extends 'frontoffice/index.html.twig' %}

{% block title %}Accueil - HireHive{% endblock %}

{% block frontoffice_content %}
{% set welcomeMessage = welcomeMessage|default('Bienvenue sur HireHive !') %}
{% set total_offers = total_offers|default(0) %}
{% set total_trainings = total_trainings|default(0) %}
{% set scheduled_interviews = scheduled_interviews|default(0) %}
{% set user_certifications = user_certifications|default(0) %}
{% set recent_offers = recent_offers|default([]) %}
{% set recommended_formations = recommended_formations|default([]) %}

<div class="home-light">
  <header class="home-hero">
    <div class="hero-text">
      <div class="hero-logo">
        <img src="/assets/logo.png" alt="HireHive">
      </div>
      <p class="hero-kicker">Plateforme RH moderne</p>
      <h1>{{ welcomeMessage }}</h1>
      <p class="hero-sub">Trouvez des talents, postulez à des offres et suivez vos candidatures dans un espace unique.</p>
      <div class="hero-actions">
        <a class="btn-primary" href="{{ path('app_frontoffice_profile') }}">Voir mon profil</a>
        <a class="btn-secondary" href="{{ path('app_frontoffice_offers') }}">Découvrir les offres</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-card">
        <div class="hero-card-title">Vue d’ensemble</div>
        <div class="mini-grid">
          <div class="mini-card"><div class="mini-label">Offres</div><div class="mini-value">{{ total_offers }}</div></div>
          <div class="mini-card"><div class="mini-label">Formations</div><div class="mini-value">{{ total_trainings }}</div></div>
          <div class="mini-card"><div class="mini-label">Entretiens</div><div class="mini-value">{{ scheduled_interviews }}</div></div>
          <div class="mini-card"><div class="mini-label">Certifs</div><div class="mini-value">{{ user_certifications }}</div></div>
        </div>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="section-kicker">Tableau de bord</p>
        <h2>Chiffres clés</h2>
      </div>
      <button class="btn-ghost" onclick="alert('Recherche bientôt disponible')">🔍 Rechercher</button>
    </div>
    <div class="stats-grid">
      <div class="stat-light"><div class="stat-label">Offres disponibles</div><div class="stat-value">{{ total_offers }}</div></div>
      <div class="stat-light"><div class="stat-label">Formations</div><div class="stat-value">{{ total_trainings }}</div></div>
      <div class="stat-light"><div class="stat-label">Entretiens planifiés</div><div class="stat-value">{{ scheduled_interviews }}</div></div>
      <div class="stat-light"><div class="stat-label">Certifications</div><div class="stat-value">{{ user_certifications }}</div></div>
    </div>
  </section>

  <section class="section two-col">
    <div class="panel">
      <div class="panel-head">
        <div><p class="section-kicker">Nouveautés</p><h3>Offres récentes</h3></div>
      </div>
      <div class="list">
        {% for offer in recent_offers %}
          <div class="list-item">
            <div>
              <div class="item-title">{{ offer.title }}</div>
              <div class="item-meta">{{ offer.company }}</div>
            </div>
            <div class="item-badge">{{ offer.date }}</div>
          </div>
        {% else %}
          <div class="empty">Aucune offre pour le moment.</div>
        {% endfor %}
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">
        <div><p class="section-kicker">À suivre</p><h3>Formations recommandées</h3></div>
      </div>
      <div class="list">
        {% for formation in recommended_formations %}
          <div class="list-item">
            <div>
              <div class="item-title">{{ formation.title }}</div>
              <div class="item-meta">{{ formation.meta }}</div>
            </div>
            <div class="item-badge">{{ formation.badge }}</div>
          </div>
        {% else %}
          <div class="empty">Aucune formation suggérée.</div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

<style>
:root {
  --bg: #f6f7fb;
  --card: #ffffff;
  --border: #e5e7eb;
  --text: #0f172a;
  --muted: #64748b;
  --primary: #7c3aed;
  --primary-2: #6d28d9;
  --shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
}
.home-light{background:var(--bg);padding:28px 32px 48px;max-width:1200px;margin:0 auto;}
.home-hero{display:grid;grid-template-columns:1.4fr 1fr;gap:24px;align-items:center;margin-bottom:28px;}
.hero-text{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:24px;box-shadow:var(--shadow);}
.hero-logo img{height:54px;margin-bottom:12px;}
.hero-kicker{margin:0;color:var(--muted);font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:.5px;}
.hero-text h1{margin:6px 0 10px;font-size:30px;color:var(--text);}
.hero-sub{margin:0 0 14px;color:var(--muted);font-size:15px;line-height:1.5;}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap;}
.btn-primary{background:var(--primary);color:white;text-decoration:none;padding:10px 16px;border-radius:10px;font-weight:700;box-shadow:var(--shadow);}
.btn-primary:hover{background:var(--primary-2);}
.btn-secondary{border:1px solid var(--border);color:var(--text);text-decoration:none;padding:10px 16px;border-radius:10px;font-weight:700;background:white;}
.hero-visual .hero-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:18px;box-shadow:var(--shadow);}
.hero-card-title{font-weight:700;color:var(--text);margin-bottom:12px;}
.mini-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
.mini-card{background:#f9fafb;border:1px solid var(--border);border-radius:10px;padding:12px;}
.mini-label{color:var(--muted);font-size:12px;margin-bottom:4px;}
.mini-value{font-weight:800;font-size:18px;color:var(--text);}
.section{margin-top:10px;}
.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;}
.section-kicker{margin:0;color:var(--muted);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.4px;}
.section h2,.section h3{margin:4px 0 0;color:var(--text);}
.btn-ghost{background:transparent;border:1px solid var(--border);padding:9px 14px;border-radius:10px;font-weight:600;cursor:pointer;}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.stat-light{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;box-shadow:var(--shadow);}
.stat-label{color:var(--muted);font-size:13px;margin:0 0 6px;}
.stat-value{margin:0;font-weight:800;font-size:22px;color:var(--text);}
.two-col{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px;}
.panel{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;box-shadow:var(--shadow);}
.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
.list{display:flex;flex-direction:column;gap:10px;}
.list-item{display:flex;justify-content:space-between;align-items:center;padding:12px;border:1px solid var(--border);border-radius:10px;background:#f9fafb;}
.item-title{font-weight:700;color:var(--text);margin-bottom:2px;}
.item-meta{color:var(--muted);font-size:13px;}
.item-badge{background:var(--primary);color:white;padding:6px 10px;border-radius:8px;font-weight:700;font-size:12px;}
.empty{color:var(--muted);padding:12px;border:1px dashed var(--border);border-radius:10px;text-align:center;background:#f9fafb;}
@media (max-width: 900px){.home-hero{grid-template-columns:1fr;}.stats-grid{grid-template-columns:repeat(2,1fr);} }
@media (max-width: 640px){.stats-grid{grid-template-columns:1fr;} .hero-text h1{font-size:24px;} }
</style>
{% endblock %}
