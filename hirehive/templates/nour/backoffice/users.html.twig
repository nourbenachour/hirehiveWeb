{% extends 'nour/backoffice/layout.html.twig' %}

{% block title %}Utilisateurs - Backoffice{% endblock %}

{% block backoffice_content %}
<style>
    /* Inline style to guarantee the violet pro table even if bundle cache lags */
    .user-card-inline {
        position: relative;
        background: radial-gradient(circle at 20% 0%, rgba(168,85,247,0.08), transparent 45%), #0f0f17;
        border: 1px solid #1c1b2d;
        border-radius: 14px;
        box-shadow: 0 20px 44px rgba(0,0,0,0.45), 0 0 0 1px rgba(168,85,247,0.09);
        overflow: hidden;
    }
    .user-card-inline::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        border-radius: 14px;
        box-shadow: 0 -3px 24px rgba(168,85,247,0.18);
    }
    .user-table-inline {
        width: 100%;
        border-collapse: collapse;
        color: #e5e7eb;
        background: #0f0f17;
        table-layout: fixed;
    }
    .user-table-inline thead th {
        position: sticky;
        top: 0;
        background: linear-gradient(90deg, rgba(124,58,237,0.22), rgba(124,58,237,0.05));
        border-bottom: 1px solid #221c38;
        padding: 14px 12px;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        box-shadow: 0 6px 12px rgba(0,0,0,0.35);
        white-space: nowrap;
    }
    .user-table-inline tbody td {
        padding: 12px 12px;
        border-bottom: 1px solid #1c1b2d;
        font-size: 14px;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }
    .user-table-inline tbody tr:nth-child(even) { background: rgba(255,255,255,0.01); }
    .user-table-inline tbody tr:hover {
        background: linear-gradient(90deg, rgba(124,58,237,0.08), rgba(14,165,233,0.02));
        box-shadow: inset 2px 0 0 rgba(168,85,247,0.55);
    }
    .user-table-inline .left { text-align: left; }
    .user-table-inline th.col-prenom, .user-table-inline td.col-prenom { width: 8%; }
    .user-table-inline th.col-nom,    .user-table-inline td.col-nom    { width: 10%; }
    .user-table-inline th.col-email,  .user-table-inline td.col-email  { width: 18%; }
    .user-table-inline th.col-phone,  .user-table-inline td.col-phone  { width: 12%; }
    .user-table-inline th.col-role,   .user-table-inline td.col-role   { width: 10%; }
    .user-table-inline th.col-status, .user-table-inline td.col-status { width: 10%; }
    .user-table-inline th.col-active, .user-table-inline td.col-active { width: 7%; }
    .user-table-inline th.col-date,   .user-table-inline td.col-date   { width: 10%; }
    .user-table-inline th.col-actions,.user-table-inline td.col-actions{ width: 13%; }
    .badge-inline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.4px;
    }
    .badge-verify-inline { background: rgba(37,99,235,0.18); color:#93c5fd; border:1px solid rgba(59,130,246,0.65); box-shadow:0 0 8px rgba(59,130,246,0.25); }
    .badge-active-inline { background: rgba(22,163,74,0.14); color:#34d399; border:1px solid rgba(52,211,153,0.6); box-shadow:0 0 8px rgba(52,211,153,0.35); }
    .role-chip-inline { padding:6px 10px; border-radius:999px; font-size:12px; font-weight:700; letter-spacing:0.3px; }
    .role-admin-inline { background: rgba(168,85,247,0.16); color:#d9b4ff; border:1px solid rgba(168,85,247,0.55); }
    .role-recruiter-inline { background: rgba(37,99,235,0.16); color:#bfdbfe; border:1px solid rgba(59,130,246,0.55); }
    .role-candidate-inline { background: rgba(14,165,233,0.14); color:#a5f3fc; border:1px solid rgba(14,165,233,0.5); }
    .actions-inline { display:flex; gap:12px; justify-content:center; align-items:center; padding:6px 4px; }
    .pill-inline { display:inline-flex; align-items:center; justify-content:center; min-width:64px; padding:0 14px; height:34px; border-radius:12px; border:1px solid rgba(124,58,237,0.65); background:linear-gradient(135deg, rgba(124,58,237,0.28), rgba(124,58,237,0.14)); color:#f8fafc; font-weight:800; font-size:12px; letter-spacing:0.3px; cursor:pointer; transition:transform .18s ease, box-shadow .18s ease, filter .18s ease; box-shadow:0 10px 18px rgba(168,85,247,0.32), inset 0 0 0 1px rgba(255,255,255,0.03); text-decoration:none; }
    .pill-inline:hover { transform: translateY(-2px); box-shadow:0 14px 24px rgba(168,85,247,0.4), inset 0 0 0 1px rgba(255,255,255,0.08); filter:brightness(1.05); }
    .pill-blue-inline { background: linear-gradient(145deg, #6d28d9 0%, #8b5cf6 55%, #a855f7 100%); border-color: rgba(124,58,237,0.9); color:#f8fafc; }
    .pill-green-inline{ background: linear-gradient(145deg, #0ea5e9 0%, #22c55e 100%); border-color: rgba(34,197,94,0.75); color:#f0fff4; }
    .pill-red-inline  { background: linear-gradient(145deg, #ef4444 0%, #f97316 80%); border-color: rgba(239,68,68,0.85); color:#fff5f5; box-shadow:0 10px 18px rgba(239,68,68,0.32), inset 0 0 0 1px rgba(255,255,255,0.04); }
</style>
<div class="user-page">
    <div class="user-page-header" style="display:flex; align-items:center; gap:12px;">
        <div>
            <h2 class="user-page-title">UTILISATEURS</h2>
            <p class="user-page-subtitle">Comptes, rôles et statuts des membres</p>
        </div>
        <div style="margin-left:auto;">
            <a href="{{ path('app_backoffice_users_new') }}" class="pill-inline pill-green-inline">Ajouter</a>
        </div>
    </div>

    {% set users = users ?? [
        { firstname:'Admin', lastname:'HireHive', email:'hirehive29@gmail.com', phone:'+216 21 963 144', role:'ADMIN', verify:'-', active:true, created:'26-03-29 20:00', updated:'26-03-29 20:02' },
        { firstname:'nour', lastname:'ben achour', email:'whaifaa60@gmail.com', phone:'+216 93 403 675', role:'RECRUITER', verify:'Vérifie', active:true, created:'26-03-29 17:54', updated:'26-03-29 17:54' },
        { firstname:'nour', lastname:'ben achour', email:'whaifaa60@gmail.com', phone:'+216 93 403 675', role:'RECRUITER', verify:'Vérifie', active:true, created:'26-03-29 17:52', updated:'26-03-29 17:52' },
        { firstname:'delice', lastname:'akrmi', email:'sarah@gmail.com', phone:'93403675', role:'RECRUITER', verify:'Vérifie', active:true, created:'26-02-28 21:14', updated:'26-02-28 21:18' },
        { firstname:'rahmouni', lastname:'malek', email:'benismailade@gmail.com', phone:'+216 93 403 675', role:'CANDIDATE', verify:'Vérifie', active:true, created:'26-02-27 21:03', updated:'26-02-28 02:24' },
        { firstname:'adem', lastname:'ben ismael', email:'adembenismaile@gmail.com', phone:'93403675', role:'CANDIDATE', verify:'Vérifie', active:true, created:'26-02-27 18:42', updated:'26-02-28 16:37' },
        { firstname:'vbbb', lastname:'b bbb', email:'YHY.HUU123@gmail.com', phone:'98765876', role:'CANDIDATE', verify:'Vérifie', active:true, created:'26-02-18 22:30', updated:'26-02-28 22:40' },
        { firstname:'nour', lastname:'ba', email:'nourbenachour@gmail.com', phone:'23456455', role:'CANDIDATE', verify:'Vérifie', active:true, created:'26-02-18 22:14', updated:'26-03-01 05:03' },
        { firstname:'nano', lastname:'nnn', email:'nanon.nano12@gmail.com', phone:'12312359', role:'CANDIDATE', verify:'Vérifie', active:true, created:'26-02-18 21:58', updated:'26-02-28 22:42' }
    ] %}

    <div class="user-card-inline">
        <div class="user-table-wrapper">
            <table class="user-table-inline">
                <thead>
                    <tr>
                        <th class="left col-prenom">Prenom</th>
                        <th class="left col-nom">Nom</th>
                        <th class="left col-email">Email</th>
                        <th class="col-phone">Téléphone</th>
                        <th class="col-role">Role</th>
                        <th class="col-status">Statut / Ent.</th>
                        <th class="col-active">Actif</th>
                        <th class="col-date">Créé le</th>
                        <th class="col-date">Maj le</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td class="left col-prenom">{{ user.firstname }}</td>
                        <td class="left col-nom">{{ user.lastname }}</td>
                        <td class="left col-email">{{ user.email }}</td>
                        <td class="col-phone">{{ user.phone ?? '' }}</td>
                        <td class="col-role">
                            {% set role_class = user.role|lower == 'admin' ? 'role-admin-inline' : (user.role|lower == 'recruiter' ? 'role-recruiter-inline' : 'role-candidate-inline') %}
                            <span class="role-chip-inline {{ role_class }}">{{ user.role }}</span>
                        </td>
                        {% set statusLabel = (user.status ?? user.verify ?? 'Vérifie') %}
                        <td class="col-status"><span class="badge-inline badge-verify-inline">{{ statusLabel }}</span></td>
                        {% set active = user.isActive ?? user.active ?? true %}
                        <td class="col-active"><span class="badge-inline badge-active-inline">{{ active ? 'Actif' : 'Inactif' }}</span></td>
                        <td class="col-date">{{ user.createdAt is defined and user.createdAt ? user.createdAt|date('d-m-y H:i') : (user.created ?? '') }}</td>
                        <td class="col-date">{{ user.updatedAt is defined and user.updatedAt ? user.updatedAt|date('d-m-y H:i') : (user.updated ?? '') }}</td>
                        <td class="actions-cell col-actions">
                            <div class="actions-inline">
                                <a class="pill-inline pill-blue-inline" aria-label="Edit" href="{{ path('app_backoffice_users_edit', {id: user.id ?? 0}) }}">Edit</a>
                                <form method="post" action="{{ path('app_backoffice_users_delete', {id: user.id ?? 0}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ (user.id ?? 0)) }}">
                                    <button type="submit" class="pill-inline pill-red-inline" aria-label="Delete">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
