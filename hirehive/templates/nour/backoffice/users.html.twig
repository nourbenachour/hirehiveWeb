    <div class="user-table-card">
        <div class="user-table-wrapper">
            <table class="user-table">
                <thead>
                    <tr>
                        <th class="left">Prenom</th>
                        <th class="left">Nom</th>
                        <th class="left">Email</th>
                        <th>Téléphone</th>
                        <th>Role</th>
                        <th>Statut / Ent.</th>
                        <th>Actif</th>
                        <th>Créé le</th>
                        <th>Maj le</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td class="left">{{ user.firstname }}</td>
                        <td class="left">{{ user.lastname }}</td>
                        <td class="left">{{ user.email }}</td>
                        <td>{{ user.phone }}</td>
                        <td>{{ user.role }}</td>
                        <td><span class="badge badge-verify">{{ user.verify }}</span></td>
                        <td><span class="badge badge-active">Actif</span></td>
                        <td>{{ user.created }}</td>
                        <td>{{ user.updated }}</td>
                        <td class="actions-cell">
                            <button type="button" class="pill-btn pill-blue" aria-label="R">R</button>
                            <button type="button" class="pill-btn pill-green" aria-label="E">E</button>
                            <button type="button" class="pill-btn pill-red" aria-label="D">D</button>
                        </td>
                    </tr>
                {% endfor %}
