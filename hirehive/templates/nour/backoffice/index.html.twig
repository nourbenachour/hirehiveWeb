{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord - HireHive{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('build/styles.css') }}">
{% endblock %}

{% block body %}
<div class="admin-root">
  <!-- Admin Header -->
  <div class="admin-header">
    <div class="admin-header-content" style="padding: 24px 32px;">
      <h1 class="admin-title">Tableau de Bord des Réclamations</h1>
      <p class="admin-subtitle">Aperçu des statistiques et indicateurs clés.</p>
    </div>
  </div>

  <!-- Main Content -->
  <div class="admin-content" style="padding: 0 32px 32px 32px;">
    
    <!-- Stats Grid - 4 Cartes -->
    <div class="stats-grid" style="margin-bottom: 32px;">
      
      <!-- Total Réclamations (Bleu) -->
      <div class="stat-card stat-card-blue">
        <div class="stat-label">Total Réclamations</div>
        <div class="stat-value">{{ total_claims|default(156) }}</div>
      </div>

      <!-- En Attente (Jaune) -->
      <div class="stat-card stat-card-yellow">
        <div class="stat-label">En Attente</div>
        <div class="stat-value">{{ open_claims|default(42) }}</div>
      </div>

      <!-- Priorité Urgente (Rouge) -->
      <div class="stat-card stat-card-red">
        <div class="stat-label">Priorité Urgente</div>
        <div class="stat-value">{{ urgent_claims|default(8) }}</div>
      </div>

      <!-- Résolues (Vert) -->
      <div class="stat-card stat-card-green">
        <div class="stat-label">Résolues</div>
        <div class="stat-value">{{ resolved_claims|default(106) }}</div>
      </div>
    </div>

    <!-- Chart Container -->
    <div class="chart-container">
      <h2 class="chart-title">Répartition par Type</h2>
      <div class="chart-placeholder">
        <p>Le graphique sera chargé ici...</p>
      </div>
    </div>

  </div>

</div>

<style>
  .admin-root {
    background-color: #0a0a0f;
    min-height: 100vh;
    font-family: "Segoe UI", "SF Pro Display", system-ui, sans-serif;
  }

  .admin-header {
    background-color: #0a0a0f;
    border-bottom: 1px solid #1a1a24;
  }

  .admin-title {
    color: #e2e8f0;
    font-size: 32px;
    font-weight: bold;
    margin: 0 0 8px 0;
  }

  .admin-subtitle {
    color: #64748b;
    font-size: 14px;
    margin: 0;
  }

  .admin-content {
    background-color: #0a0a0f;
    padding-top: 32px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .stat-card {
    background-color: #12121a;
    border: 1px solid #252530;
    border-radius: 12px;
    padding: 20px;
    position: relative;
    overflow: hidden;
  }

  .stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
  }

  .stat-card-blue::before {
    background-color: #0ea5e9;
  }

  .stat-card-yellow::before {
    background-color: #f59e0b;
  }

  .stat-card-red::before {
    background-color: #ef4444;
  }

  .stat-card-green::before {
    background-color: #10b981;
  }

  .stat-label {
    color: #64748b;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .stat-value {
    color: #f1f5f9;
    font-size: 36px;
    font-weight: bold;
    line-height: 1;
  }

  .chart-container {
    background-color: #12121a;
    border: 1px solid #252530;
    border-radius: 12px;
    padding: 20px;
  }

  .chart-title {
    color: #f1f5f9;
    font-size: 18px;
    font-weight: bold;
    margin: 0 0 16px 0;
  }

  .chart-placeholder {
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    border: 1px dashed #252530;
  }

  .chart-placeholder p {
    color: #64748b;
    font-size: 14px;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
    
    .admin-title {
      font-size: 24px;
    }
  }
</style>
{% endblock %}
