<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HireHive | Connexion</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --purple-900: #4c1d95;
      --purple-800: #5b21b6;
      --purple-700: #6d28d9;
      --purple-600: #7c3aed;
      --purple-500: #8b5cf6;
      --gray-900: #0f172a;
      --gray-800: #1f2937;
      --gray-700: #334155;
      --gray-500: #64748b;
      --gray-300: #e2e8f0;
      --gray-200: #e5e7eb;
      --gray-100: #f1f5f9;
      --card-bg: #f9fbff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
      background: radial-gradient(circle at 20% 20%, rgba(168, 85, 247, 0.12), transparent 34%),
                  radial-gradient(circle at 80% 0%, rgba(124, 58, 237, 0.16), transparent 30%),
                  linear-gradient(135deg, #f7f8ff 0%, #eef3ff 100%);
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 22px;
    }
    .layout {
      width: 100%;
      max-width: 1180px;
      min-height: 600px;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 0;
      background: white;
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 28px 70px rgba(15, 23, 42, 0.18);
    }
    .hero {
      position: relative;
      background: linear-gradient(135deg, rgba(76,29,149,0.72), rgba(124,58,237,0.62)),
                  url('https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
      color: white;
      display: flex;
      align-items: center;
      padding: 48px;
    }
    .hero-content {
      max-width: 540px;
    }
    .pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 8px 16px;
      background: rgba(255,255,255,0.16);
      border: 1px solid rgba(255,255,255,0.3);
      color: #ede9fe;
      border-radius: 999px;
      font-weight: 700;
      letter-spacing: 0.3px;
      font-size: 12px;
      text-transform: uppercase;
      margin-bottom: 18px;
    }
    .hero h1 {
      margin: 0 0 10px;
      font-size: 40px;
      font-weight: 800;
      line-height: 1.05;
    }
    .hero h2 {
      margin: 0 0 22px;
      font-size: 32px;
      font-weight: 700;
      line-height: 1.15;
    }
    .hero p {
      margin: 0;
      font-size: 17px;
      line-height: 1.6;
      color: #e0e7ff;
    }
    .panel {
      background: linear-gradient(135deg, #f9fbff 0%, #eef2ff 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 36px 42px;
    }
    .card {
      width: 100%;
      max-width: 480px;
      background: #ffffff;
      border-radius: 18px;
      border: 1px solid var(--gray-200);
      box-shadow: 0 16px 40px rgba(148, 163, 184, 0.18);
      padding: 26px 28px 30px;
    }
    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 700;
      font-size: 13px;
      color: var(--purple-700);
      margin-bottom: 10px;
    }
    .card-top .connect {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--gray-500);
      font-weight: 600;
    }
    .google-icon {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: conic-gradient(#ea4335 0 25%, #fbbc05 25% 50%, #34a853 50% 75%, #4285f4 75% 100%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      color: white;
      font-size: 12px;
    }
    .logo-row {
      display: flex;
      justify-content: center;
      margin: 6px 0 18px;
    }
    .logo-row img {
      height: 34px;
    }
    h1.title {
      margin: 0 0 6px;
      font-size: 36px;
      font-weight: 800;
      color: var(--gray-900);
    }
    .subtitle {
      margin: 0 0 22px;
      color: var(--gray-500);
      font-size: 15px;
    }
    label {
      display: block;
      font-weight: 700;
      font-size: 14px;
      color: var(--gray-800);
      margin-bottom: 6px;
    }
    input[type="email"],
    input[type="password"] {
      width: 100%;
      padding: 12px 13px;
      border-radius: 10px;
      border: 1px solid var(--gray-300);
      background: var(--gray-100);
      font-size: 15px;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
      margin-bottom: 12px;
    }
    input:focus {
      outline: none;
      background: white;
      border-color: var(--purple-600);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.18);
    }
    .forgot {
      display: block;
      text-align: right;
      margin: -2px 0 18px;
      font-weight: 700;
      color: var(--purple-700);
      text-decoration: none;
      font-size: 14px;
    }
    .forgot:hover { text-decoration: underline; }
    .btn {
      width: 100%;
      padding: 12px 14px;
      border-radius: 12px;
      border: 2px solid transparent;
      font-weight: 800;
      font-size: 16px;
      cursor: pointer;
      transition: transform 0.1s ease, box-shadow 0.2s ease, background 0.2s, color 0.2s, border-color 0.2s;
    }
    .btn-primary {
      background: linear-gradient(90deg, var(--purple-700), var(--purple-500));
      color: white;
      box-shadow: 0 14px 32px rgba(109, 40, 217, 0.28);
      margin-bottom: 12px;
      border-color: var(--purple-700);
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 18px 38px rgba(109, 40, 217, 0.32); }
    .btn-outline {
      background: white;
      color: var(--purple-700);
      border-color: #d8b4fe;
      margin-bottom: 10px;
    }
    .btn-outline:hover { background: #f5f3ff; }
    .alert {
      padding: 12px 14px;
      border-radius: 10px;
      margin-bottom: 14px;
      font-size: 14px;
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: #991b1b;
    }
    .helper {
      text-align: center;
      color: var(--gray-500);
      font-size: 13px;
      margin-top: 6px;
    }
    /* Responsive */
    @media (max-width: 980px) {
      body { padding: 12px; }
      .layout { grid-template-columns: 1fr; }
      .hero { min-height: 260px; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <section class="hero">
      <div class="hero-content">
        <div class="pill">HIREHIVE PLATFORM</div>
        <h1>HireHive</h1>
        <h2>Empowering the<br>Future of Recruitment</h2>
        <p>Connect talent with opportunity. Smart matching, intelligent insights, and seamless collaboration from day one.</p>
      </div>
    </section>

    <section class="panel">
      <div class="card">
        <div class="card-top">
          <span>FR</span>
          <span class="connect">Se connecter avec : <span class="google-icon">G</span></span>
        </div>

        <div class="logo-row">
          <img src="/assets/logo.png" alt="HireHive">
        </div>

        <h1 class="title">Bienvenue</h1>
        <p class="subtitle">Sign in to access your account</p>

        {% if error %}
          <div class="alert">Identifiants invalides.</div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
          <label for="username">Email professionnel</label>
          <input id="username" name="_username" type="email" value="{{ last_username }}" required autofocus autocomplete="email" placeholder="you@example.com">

          <label for="password">Mot de passe</label>
          <input id="password" name="_password" type="password" required autocomplete="current-password" placeholder="••••••••">

          <a class="forgot" href="#">Mot de passe oublié ?</a>

          <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

          <button class="btn btn-primary" type="submit">Connexion</button>
          <button class="btn btn-outline" type="button">Authentifier par visage</button>
          <a class="btn btn-outline" href="{{ path('app_register') }}" role="button" style="text-decoration:none;text-align:center;display:block;">S'inscrire</a>
        </form>

        <div class="helper">En cas de souci de connexion, contactez l'administrateur.</div>
      </div>
    </section>
  </div>
</body>
</html>
