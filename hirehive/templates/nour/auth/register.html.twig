<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HireHive | Inscription</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --purple-700: #6d28d9;
      --purple-500: #8b5cf6;
      --gray-900: #0f172a;
      --gray-800: #1f2937;
      --gray-700: #334155;
      --gray-500: #64748b;
      --gray-300: #e2e8f0;
      --gray-200: #e5e7eb;
      --gray-100: #f1f5f9;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
      background: radial-gradient(circle at 20% 20%, rgba(168, 85, 247, 0.12), transparent 34%),
                  radial-gradient(circle at 80% 0%, rgba(124, 58, 237, 0.16), transparent 30%),
                  linear-gradient(135deg, #f7f8ff 0%, #eef3ff 100%);
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 22px;
    }
    .layout {
      width: 100%;
      max-width: 1180px;
      min-height: 680px;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      background: white;
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 28px 70px rgba(15, 23, 42, 0.18);
    }
    .hero {
      position: relative;
      background: linear-gradient(135deg, rgba(76,29,149,0.72), rgba(124,58,237,0.62)),
                  url('https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
      color: white;
      display: flex;
      align-items: center;
      padding: 48px;
    }
    .hero-content { max-width: 520px; }
    .pill {
      display: inline-flex; padding: 8px 16px; border-radius: 999px;
      background: rgba(255,255,255,0.16); border:1px solid rgba(255,255,255,0.3);
      font-size: 12px; font-weight: 700; letter-spacing: 0.3px; margin-bottom: 18px;
    }
    .hero h1 { margin:0 0 10px; font-size: 40px; font-weight: 800; line-height:1.05; }
    .hero h2 { margin:0 0 20px; font-size: 32px; font-weight: 700; }
    .hero p { margin:0; font-size:17px; line-height:1.6; color:#e0e7ff; }

    .panel {
      background: linear-gradient(135deg, #f9fbff 0%, #eef2ff 100%);
      display: flex; align-items: center; justify-content: center;
      padding: 36px 42px;
    }
    .card {
      width: 100%; max-width: 520px;
      background: #ffffff;
      border-radius: 18px;
      border: 1px solid var(--gray-200);
      box-shadow: 0 16px 40px rgba(148, 163, 184, 0.18);
      padding: 26px 28px 30px;
    }
    h1.title { margin:0 0 6px; font-size: 34px; font-weight: 800; color: var(--gray-900); }
    .subtitle { margin:0 0 22px; color: var(--gray-500); font-size: 15px; }
    label { display:block; font-weight:700; font-size:14px; color: var(--gray-900); margin-bottom:6px; }
    input, select {
      width: 100%; padding: 12px 13px;
      border-radius: 10px; border: 1px solid var(--gray-300);
      background: var(--gray-100); font-size: 15px;
      transition: border-color .2s, box-shadow .2s, background .2s;
      margin-bottom: 12px;
    }
    input:focus, select:focus {
      outline: none; background: white; border-color: var(--purple-700);
      box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.18);
    }
    .row { display:flex; gap:10px; align-items:center; }
    .captcha-row { display:flex; gap:10px; align-items:center; margin-bottom: 12px; }
    .captcha-box {
      display:flex;
      gap: 12px;
      align-items:center;
      background: white;
      border: 1px solid var(--gray-200);
      border-radius: 12px;
      padding: 10px;
      box-shadow: 0 6px 16px rgba(148,163,184,0.18);
    }
    .badge {
      min-width: 96px; padding: 10px 12px;
      border-radius: 10px;
      background: linear-gradient(90deg, var(--purple-700), var(--purple-500));
      color: white; text-align: center; font-weight: 800; letter-spacing: 1px;
      box-shadow: inset 0 -2px 6px rgba(0,0,0,0.08);
    }
    .btn {
      width: 100%; padding: 12px 14px;
      border-radius: 12px; border: 2px solid transparent;
      font-weight: 800; font-size: 16px;
      cursor: pointer; transition: transform .1s ease, box-shadow .2s ease, background .2s;
      margin-top: 6px;
    }
    .btn-primary {
      background: linear-gradient(90deg, var(--purple-700), var(--purple-500));
      color: white; box-shadow: 0 14px 32px rgba(109, 40, 217, 0.28);
      margin-bottom: 10px;
    }
    .btn-primary:hover { transform: translateY(-1px); }
    .btn-secondary {
      background: white;
      color: var(--purple-700);
      border: 2px solid #d8b4fe;
    }
    .btn-compact { width: auto; padding: 10px 14px; white-space: nowrap; }
    .alert {
      padding: 12px 14px; border-radius: 10px; margin-bottom: 12px;
      border: 1px solid #fecaca; background: #fef2f2; color: #991b1b; font-size: 14px;
    }
    @media (max-width: 980px) {
      body { padding: 12px; }
      .layout { grid-template-columns: 1fr; }
      .hero { min-height: 260px; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <section class="hero">
      <div class="hero-content">
        <div class="pill">HIREHIVE PLATFORM</div>
        <h1>HireHive</h1>
        <h2>Inscription</h2>
        <p>Choisissez votre profil et complétez les informations obligatoires.</p>
      </div>
    </section>

    <section class="panel">
      <div class="card">
        <h1 class="title">Créer un compte</h1>
        <p class="subtitle">Tous les champs sont obligatoires</p>

        {% if error %}
          <div class="alert">{{ error }}</div>
        {% endif %}
        {% for message in app.flashes('success') %}
          <div class="alert" style="background:#ecfdf3;border-color:#bbf7d0;color:#15803d;">{{ message }}</div>
        {% endfor %}

        <form method="post" action="{{ path('app_register') }}">
          <label for="profile">Type de profil</label>
          <select id="profile" name="profile_type" required>
            <option value="">Sélectionnez un profil</option>
            <option value="CANDIDATE" {% if profile == 'CANDIDATE' %}selected{% endif %}>Candidat</option>
            <option value="RECRUITER" {% if profile == 'RECRUITER' %}selected{% endif %}>Recruteur</option>
          </select>

          <label for="last_name">Nom</label>
          <input id="last_name" name="last_name" type="text" placeholder="Nom" required>

          <label for="first_name">Prénom</label>
          <input id="first_name" name="first_name" type="text" placeholder="Prénom" required>

          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" placeholder="you@example.com" required>

          <div id="candidate-email-code" style="display:{% if profile == 'RECRUITER' %}none{% else %}block{% endif %};">
            <label for="code4">Code 4 chiffres (email)</label>
            <div class="row">
              <input id="code4" name="email_code" type="text" placeholder="Code 4 chiffres">
              <button class="btn btn-secondary btn-compact" type="button" style="margin-top:0; flex-shrink:0;">Envoyer code</button>
            </div>
          </div>

          <label for="password">Mot de passe</label>
          <input id="password" name="password" type="password" placeholder="********" required>

          <label for="phone">Téléphone</label>
            <div class="row" id="candidate-phone" style="display:{% if profile == 'RECRUITER' %}none{% else %}flex{% endif %};">
              <select name="phone_prefix" style="max-width:150px;">
                <option value="+216">TN +216</option>
                <option value="+33">FR +33</option>
                <option value="+1">US/CA +1</option>
              </select>
              <input id="phone" name="phone" type="text" placeholder="5879XXXX">
            </div>
            <div class="row" id="candidate-sms" style="display:{% if profile == 'RECRUITER' %}none{% else %}flex{% endif %};">
              <input name="sms_code" type="text" placeholder="Code SMS">
              <button class="btn btn-secondary btn-compact" type="button" style="margin-top:0; flex-shrink:0;">Envoyer SMS</button>
            </div>
          <div id="recruiter-phone" style="display:{% if profile == 'RECRUITER' %}block{% else %}none{% endif %};">
            <input name="phone_recruiter" type="text" placeholder="+216 58 79 XXXX">
          </div>

          <label>Captcha</label>
          <div class="captcha-box">
            <div class="badge">{{ captcha }}</div>
            <input type="text" name="captcha_input" placeholder="Recopiez le code affiché" required style="margin-bottom:0; flex:1;">
          </div>

          <input type="hidden" name="_csrf_token" value="{{ csrf_token('register_all') }}">

          <button class="btn btn-primary" type="submit">Valider l'inscription</button>
          <a class="btn btn-secondary" href="{{ path('app_login') }}" role="button" style="text-decoration:none;display:block;text-align:center;">Retour</a>
        </form>
      </div>
    </section>
  </div>

  <script>
    const profileSelect = document.getElementById('profile');
    const emailCode = document.getElementById('candidate-email-code');
    const phoneRow = document.getElementById('candidate-phone');
    const smsRow = document.getElementById('candidate-sms');
    const recruiterPhone = document.getElementById('recruiter-phone');

    function toggleProfile() {
      const isCandidate = profileSelect.value === 'CANDIDATE';
      emailCode.style.display = isCandidate ? 'block' : 'none';
      phoneRow.style.display = isCandidate ? 'flex' : 'none';
      smsRow.style.display = isCandidate ? 'flex' : 'none';
      recruiterPhone.style.display = isCandidate ? 'none' : 'block';
    }
    profileSelect.addEventListener('change', toggleProfile);
    toggleProfile();
  </script>
</body>
</html>
